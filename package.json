{
  "name": "tasker-effect",
  "version": "0.1.0",
  "description": "Write Tasker tasks in TypeScript with Effect, compiled to JS that Tasker runs directly",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sync/node": {
      "types": "./dist/sync/node.d.ts",
      "default": "./dist/sync/node.js"
    },
    "./sync/tasker": {
      "types": "./dist/sync/tasker.d.ts",
      "default": "./dist/sync/tasker.js"
    }
  },
  "bin": {
    "tasker-effect": "./bin/tasker-effect.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run build",
    "compile": "bun run scripts/compile-tasks.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "keywords": [
    "tasker",
    "android",
    "automation",
    "effect",
    "typescript"
  ],
  "author": "danielo515",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielo515/tasker-effect.git"
  },
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@barney-media/crap-typescript-vitest": "^0.5.1",
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
